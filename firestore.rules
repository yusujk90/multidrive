rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function isValidUserProfile(data) {
      return data.uid is string &&
        data.uid == request.auth.uid &&
        data.email is string &&
        data.email.size() <= 200 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500));
    }

    function isValidDriveAccount(data, userId) {
      return data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId &&
        data.email is string && data.email.size() <= 200 &&
        data.name is string && data.name.size() <= 100 &&
        data.storageLimit is number &&
        data.storageUsed is number &&
        data.storageAvailable is number;
    }

    function isValidPooledFile(data, userId) {
      return data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId &&
        data.accountId is string &&
        data.name is string && data.name.size() <= 255 &&
        data.mimeType is string && data.mimeType.size() <= 100;
    }

    function isValidSyncLog(data, userId) {
      return data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId &&
        data.action is string && data.action.size() <= 100 &&
        data.status is string && data.status.size() <= 50 &&
        data.message is string && data.message.size() <= 10000;
    }

    function isValidChatMessage(data, userId) {
      return data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId &&
        data.role is string && (data.role == 'user' || data.role == 'model' || data.role == 'assistant') &&
        data.content is string && data.content.size() <= 10000;
    }

    // User profile document rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data) &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);

      // Connected Drive Accounts subcollection
      match /drive_accounts/{accountId} {
        allow get: if isOwner(userId) && isValidId(accountId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(accountId) && isValidDriveAccount(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(accountId) && isValidDriveAccount(request.resource.data, userId) &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(accountId);
      }

      // Pooled Files catalog subcollection
      match /pooled_files/{fileId} {
        allow get: if isOwner(userId) && isValidId(fileId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(fileId) && isValidPooledFile(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(fileId) && isValidPooledFile(request.resource.data, userId) &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(fileId);
      }

      // Sync Logs subcollection
      match /sync_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidSyncLog(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(logId) && isValidSyncLog(request.resource.data, userId) &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Chat Messages subcollection
      match /chat_messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(messageId) && isValidChatMessage(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(messageId) && isValidChatMessage(request.resource.data, userId);
        allow delete: if isOwner(userId) && isValidId(messageId);
      }
    }
  }
}
